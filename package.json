{
  "name": "browser",
  "version": "120.0.0",
  "description": "Ghost Browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "author": "User",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.user.browser",
    "productName": "Ghost Browser",
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "assets/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "files": ["**/*", "!dist/**"]
  }
}